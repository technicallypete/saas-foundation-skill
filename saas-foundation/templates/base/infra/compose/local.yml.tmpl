# Local development stack. Run from the repository root:
#   docker compose --env-file .env -f infra/compose/local.yml up -d --build --wait
# Every value comes from .env (single source); required values fail closed.
# Networks: edge (web<->core), data (core<->stores){{if .IntelligenceEnabled}}, inference (core<->intelligence){{end}}.
# web never joins data{{if .IntelligenceEnabled}} or inference; intelligence never joins data{{end}}.
name: ${COMPOSE_PROJECT_NAME:?COMPOSE_PROJECT_NAME is required}

services:
  postgres:
    image: pgvector/pgvector:0.8.7-pg17
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_SUPERUSER_PASSWORD:?POSTGRES_SUPERUSER_PASSWORD is required}
      POSTGRES_DB: ${DATABASE_NAME:?DATABASE_NAME is required}
      DATABASE_NAME: ${DATABASE_NAME:?DATABASE_NAME is required}
      DB_MIGRATOR_PASSWORD: ${DB_MIGRATOR_PASSWORD:?DB_MIGRATOR_PASSWORD is required}
      DB_RUNTIME_PASSWORD: ${DB_RUNTIME_PASSWORD:?DB_RUNTIME_PASSWORD is required}
      DB_RETENTION_PASSWORD: ${DB_RETENTION_PASSWORD:?DB_RETENTION_PASSWORD is required}
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ../postgres/init:/docker-entrypoint-initdb.d:ro
    ports:
      - "${BIND_ADDRESS:?BIND_ADDRESS is required}:${POSTGRES_PORT:?POSTGRES_PORT is required}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d \"$${POSTGRES_DB}\""]
      interval: 3s
      timeout: 3s
      retries: 30
    networks: [data]

  redis:
    image: redis:8.10.2-alpine
    # Ephemeral by design: no snapshots, no append-only file.
    command: ["sh", "-c", "exec redis-server --save '' --appendonly no --requirepass \"$$REDIS_PASSWORD\""]
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD is required}
    ports:
      - "${BIND_ADDRESS:?BIND_ADDRESS is required}:${REDIS_PORT:?REDIS_PORT is required}:6379"
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=\"$$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"]
      interval: 3s
      timeout: 3s
      retries: 30
    networks: [data]

  minio:
    build:
      context: ../docker
      dockerfile: minio.Dockerfile
      target: server
    command: ["server", "/data", "--address", ":9000", "--console-address", ":9001"]
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?MINIO_ROOT_USER is required}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?MINIO_ROOT_PASSWORD is required}
    volumes:
      - minio-data:/data
    ports:
      - "${BIND_ADDRESS:?BIND_ADDRESS is required}:${MINIO_API_PORT:?MINIO_API_PORT is required}:9000"
      - "${BIND_ADDRESS:?BIND_ADDRESS is required}:${MINIO_CONSOLE_PORT:?MINIO_CONSOLE_PORT is required}:9001"
    healthcheck:
      test: ["CMD", "/usr/bin/mc", "ready", "local"]
      interval: 3s
      timeout: 5s
      retries: 40
    networks: [data]

  minio-init:
    build:
      context: ../docker
      dockerfile: minio.Dockerfile
      target: init
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?MINIO_ROOT_USER is required}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?MINIO_ROOT_PASSWORD is required}
      OBJECT_STORE_BUCKET: ${OBJECT_STORE_BUCKET:?OBJECT_STORE_BUCKET is required}
      OBJECT_STORE_ACCESS_KEY: ${OBJECT_STORE_ACCESS_KEY:?OBJECT_STORE_ACCESS_KEY is required}
      OBJECT_STORE_SECRET_KEY: ${OBJECT_STORE_SECRET_KEY:?OBJECT_STORE_SECRET_KEY is required}
    volumes:
      - ../minio/init.sh:/init.sh:ro
    entrypoint: ["/bin/sh", "/init.sh"]
    restart: "no"
    depends_on:
      minio:
        condition: service_healthy
    networks: [data]

  core:
    build:
      context: ../../core
      dockerfile: ../infra/docker/core.Dockerfile
      target: runtime
    environment:
      PRODUCT_NAME: ${PRODUCT_NAME:?PRODUCT_NAME is required}
      PLATFORM_BASE_DOMAIN: ${PLATFORM_BASE_DOMAIN:?PLATFORM_BASE_DOMAIN is required}
      CUSTOM_DOMAIN_CNAME_TARGET: ${CUSTOM_DOMAIN_CNAME_TARGET:?CUSTOM_DOMAIN_CNAME_TARGET is required}
      DATABASE_NAME: ${DATABASE_NAME:?DATABASE_NAME is required}
      APP_ENV: ${APP_ENV:?APP_ENV is required}
      CORE_LISTEN_ADDR: ":8180"
      DB_HOST: postgres
      DB_PORT: "5432"
      DB_USER: ${DATABASE_NAME:?DATABASE_NAME is required}_runtime
      DB_PASSWORD: ${DB_RUNTIME_PASSWORD:?DB_RUNTIME_PASSWORD is required}
      REDIS_HOST: ${REDIS_HOST:?REDIS_HOST is required}
      REDIS_PORT: ${REDIS_PORT_INTERNAL:?REDIS_PORT_INTERNAL is required}
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD is required}
      OBJECT_STORE_ENDPOINT: ${OBJECT_STORE_ENDPOINT:?OBJECT_STORE_ENDPOINT is required}
      OBJECT_STORE_REGION: ${OBJECT_STORE_REGION:?OBJECT_STORE_REGION is required}
      OBJECT_STORE_BUCKET: ${OBJECT_STORE_BUCKET:?OBJECT_STORE_BUCKET is required}
      OBJECT_STORE_FORCE_PATH_STYLE: ${OBJECT_STORE_FORCE_PATH_STYLE:?OBJECT_STORE_FORCE_PATH_STYLE is required}
      OBJECT_STORE_ACCESS_KEY: ${OBJECT_STORE_ACCESS_KEY:?OBJECT_STORE_ACCESS_KEY is required}
      OBJECT_STORE_SECRET_KEY: ${OBJECT_STORE_SECRET_KEY:?OBJECT_STORE_SECRET_KEY is required}
{{- if .IntelligenceEnabled}}
      INTELLIGENCE_URL: ${INTELLIGENCE_URL:?INTELLIGENCE_URL is required}
      INTELLIGENCE_SERVICE_TOKEN: ${INTELLIGENCE_SERVICE_TOKEN:?INTELLIGENCE_SERVICE_TOKEN is required}
{{- end}}
    ports:
      - "${BIND_ADDRESS:?BIND_ADDRESS is required}:${CORE_PORT:?CORE_PORT is required}:8180"
    healthcheck:
      test: ["CMD", "/usr/local/bin/server", "healthcheck"]
      interval: 3s
      timeout: 3s
      retries: 30
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_healthy
      minio-init:
        condition: service_completed_successfully
    networks: [edge, data{{if .IntelligenceEnabled}}, inference{{end}}]

  web:
    build:
      context: ../../web
      dockerfile: ../infra/docker/web.Dockerfile
      target: runtime
    environment:
      PRODUCT_NAME: ${PRODUCT_NAME:?PRODUCT_NAME is required}
      PLATFORM_BASE_DOMAIN: ${PLATFORM_BASE_DOMAIN:?PLATFORM_BASE_DOMAIN is required}
      CUSTOM_DOMAIN_CNAME_TARGET: ${CUSTOM_DOMAIN_CNAME_TARGET:?CUSTOM_DOMAIN_CNAME_TARGET is required}
      APP_ENV: ${APP_ENV:?APP_ENV is required}
      CORE_INTERNAL_URL: ${CORE_INTERNAL_URL:?CORE_INTERNAL_URL is required}
    ports:
      - "${BIND_ADDRESS:?BIND_ADDRESS is required}:${WEB_PORT:?WEB_PORT is required}:3000"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 3s
      timeout: 3s
      retries: 40
    depends_on:
      core:
        condition: service_healthy
    networks: [edge]
{{- if .IntelligenceEnabled}}

  intelligence:
    build:
      context: ../../intelligence
      dockerfile: ../infra/docker/intelligence.Dockerfile
      target: runtime
      additional_contexts:
        contracts: ../../contracts
    environment:
      APP_ENV: ${APP_ENV:?APP_ENV is required}
      INTELLIGENCE_SERVICE_TOKEN: ${INTELLIGENCE_SERVICE_TOKEN:?INTELLIGENCE_SERVICE_TOKEN is required}
      # Optional values use ${VAR-}: unset means "not configured".
      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY-}
      AI_MODEL_CHAT: ${AI_MODEL_CHAT-}
      AI_MODEL_CHAT_FALLBACKS: ${AI_MODEL_CHAT_FALLBACKS-}
      AI_MODEL_FAST: ${AI_MODEL_FAST-}
      AI_MODEL_FAST_FALLBACKS: ${AI_MODEL_FAST_FALLBACKS-}
      AI_MODEL_REASONING: ${AI_MODEL_REASONING-}
      AI_MODEL_REASONING_FALLBACKS: ${AI_MODEL_REASONING_FALLBACKS-}
      AI_MODEL_EXTRACTION: ${AI_MODEL_EXTRACTION-}
      AI_MODEL_EXTRACTION_FALLBACKS: ${AI_MODEL_EXTRACTION_FALLBACKS-}
      AI_MODEL_EMBEDDING: ${AI_MODEL_EMBEDDING-}
      AI_MODEL_EMBEDDING_FALLBACKS: ${AI_MODEL_EMBEDDING_FALLBACKS-}
    ports:
      - "${BIND_ADDRESS:?BIND_ADDRESS is required}:${INTELLIGENCE_PORT:?INTELLIGENCE_PORT is required}:8000"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2).status == 200 else 1)"]
      interval: 3s
      timeout: 3s
      retries: 40
    networks: [inference]
{{- end}}

  # --- profile "checks": containerized checks, no bind-mounted writes ------
  core-check:
    profiles: [checks]
    build:
      context: ../../core
      dockerfile: ../infra/docker/core.Dockerfile
      target: check
    network_mode: none

  web-check:
    profiles: [checks]
    build:
      context: ../../web
      dockerfile: ../infra/docker/web.Dockerfile
      target: check
    network_mode: none
{{- if .IntelligenceEnabled}}

  intelligence-check:
    profiles: [checks]
    build:
      context: ../../intelligence
      dockerfile: ../infra/docker/intelligence.Dockerfile
      target: check
      additional_contexts:
        contracts: ../../contracts
    network_mode: none
{{- end}}

  secret-scan:
    profiles: [checks]
    image: zricethezav/gitleaks:v8.30.1
    command: ["dir", "/repo", "--config", "/repo/infra/security/gitleaks.toml", "--redact", "--no-banner", "--exit-code", "1"]
    volumes:
      - ../..:/repo:ro
    network_mode: none

networks:
  edge: {}
  data: {}
{{- if .IntelligenceEnabled}}
  inference: {}
{{- end}}

volumes:
  postgres-data: {}
  minio-data: {}
