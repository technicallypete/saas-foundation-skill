{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contracts:intelligence:stream-event:v1",
  "title": "Intelligence stream event",
  "description": "One newline-delimited JSON event streamed by the intelligence service in response to an execution envelope. Every event carries its type and the envelope's request_id. Events cannot carry tenant or user dimensions: core attributes usage by joining on request_id to the envelope it issued.",
  "oneOf": [
    { "$ref": "#/$defs/text_delta" },
    { "$ref": "#/$defs/tool_call" },
    { "$ref": "#/$defs/tool_result" },
    { "$ref": "#/$defs/citation" },
    { "$ref": "#/$defs/structured_output" },
    { "$ref": "#/$defs/usage" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/done" }
  ],
  "$defs": {
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,64}$" },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "call_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "text_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "text"],
      "properties": {
        "type": { "const": "text_delta" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "text": { "type": "string" }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "call_id", "name", "arguments"],
      "properties": {
        "type": { "const": "tool_call" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "call_id": { "$ref": "#/$defs/call_id" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "arguments": { "type": "object" }
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "call_id", "is_error", "content"],
      "properties": {
        "type": { "const": "tool_result" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "call_id": { "$ref": "#/$defs/call_id" },
        "is_error": { "type": "boolean" },
        "content": {}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "kind", "ref"],
      "properties": {
        "type": { "const": "citation" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "locator": { "type": "string", "maxLength": 256 }
      }
    },
    "structured_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "data"],
      "properties": {
        "type": { "const": "structured_output" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "schema_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "data": { "type": "object" }
      }
    },
    "usage": {
      "description": "Gateway usage for one execution. No tenant, user or content fields are permitted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "trace_id",
        "capability",
        "configured_provider",
        "configured_model",
        "gateway",
        "actual_provider",
        "actual_model",
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "estimated_cost"
      ],
      "properties": {
        "type": { "const": "usage" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "trace_id": { "$ref": "#/$defs/trace_id" },
        "capability": { "enum": ["chat", "fast", "reasoning", "extraction", "embedding"] },
        "configured_provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "configured_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "gateway": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "actual_provider": {
          "description": "Provider reported by gateway metadata, or \"unknown\". Never inferred.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actual_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "units": {
          "description": "Non-token usage units, for capabilities not metered in tokens.",
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "estimated_cost": {
          "description": "Gateway-reported cost estimate in the gateway's billing currency, or null when not reported.",
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "code", "message", "retryable"],
      "properties": {
        "type": { "const": "error" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "message": { "type": "string", "maxLength": 1024 },
        "retryable": { "type": "boolean" }
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id"],
      "properties": {
        "type": { "const": "done" },
        "request_id": { "$ref": "#/$defs/request_id" }
      }
    }
  }
}
